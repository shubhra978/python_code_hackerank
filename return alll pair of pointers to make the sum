#include <bits/stdc++.h>
using namespace std;


vector <pair<int,int>> sum_pointers(const vector <int> &user_input, int target){
    int left = 0;
    int right = user_input.size()-1;
    vector <pair<int,int>> result; //vector pair declared
    
    
    while(left < right){
        
        int target_sum = user_input[left] + user_input[right]; // sum of right and left elements
        
        if(target_sum == target){ //checking for elements matching
        
            result.push_back({user_input[left], user_input[right]}); //pushing each pair to vector  
            left++;
            right--;
        }
        else if (target_sum < target){
            left++;
        }
        else{
            right--;
        }
    }
    return result;
}






int main() {
	vector <int> list_of_numbers = {1,3,4,7,3,2,6};
	int target = 8;
	
	sort(list_of_numbers.begin(),list_of_numbers.end()); //sort the list of pair_numbers
	
	vector <pair<int,int>> pair_numbers = sum_pointers(list_of_numbers,target); //to return all pairs
	
	
    for(int i = 0; i < pair_numbers.size(); i++){
        if (pair_numbers.empty()) // function to check if it s empty or not
        {
            cout << "empty pair";
        }
        else{
            cout <<pair_numbers[i].first << "+" << pair_numbers[i].second << endl;
        }
    }
}
